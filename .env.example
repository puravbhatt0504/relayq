DATABASE_URL=postgresql://relayq:relayq@localhost:5432/relayq
REDIS_URL=redis://localhost:6379
PORT=3200
WORKER_CONCURRENCY=5
WEBHOOK_SECRET=change-me
# email: SMTP_URL (MailHog) if set, else SES via default AWS credentials
SMTP_URL=smtp://localhost:1025
MAIL_FROM=relayq@localhost
# board.export
PULSEBOARD_URL=http://localhost:4000
PULSEBOARD_TOKEN=
# EXPORT_BUCKET=relayq-exports  (unset = export sent inline as a data: URL in the callback)
TENANT_JOBS_PER_MIN=100
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
METRICS_PORT=9100
# embed.batch
VOYAGE_API_KEY=
# llm.complete: tenants without a TenantBudget row get LLM_DEFAULT_MONTHLY_USD (0 = denied)
ANTHROPIC_API_KEY=
LLM_DEFAULT_MONTHLY_USD=0
LLM_TPM=400000
# ml.retrain: trainer image per model (default pulseboard-ml-<name>), comma-separated URLs told about promotions
TRAINER_IMAGE_ETA=pulseboard-ml-eta
# Host dir mounted at /models in the trainer (needed when the trainer has no MODEL_BUCKET); share it with the eta server.
TRAINER_MODEL_DIR=
# e.g. http://localhost:8000/reload (pulseboard: docker compose up eta)
MODEL_SUBSCRIBERS_ETA=
