{
  "name": "relayq",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:push": "prisma db push",
    "worker": "node dist/worker/index.js",
    "dev:worker": "tsx watch src/worker/index.ts",
    "lint": "eslint .",
    "key": "node dist/cli/create-key.js",
    "migrate": "prisma migrate deploy",
    "chaos": "tsx chaos/run.ts",
    "start:all": "node dist/all.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@bull-board/api": "^5.23.0",
    "@bull-board/fastify": "^5.23.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "fastify": "^4.29.1",
    "ioredis": "^5.11.1",
    "nodemailer": "^7.0.13",
    "pino": "^9.14.0",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/redis": "^10.28.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "testcontainers": "^10.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
