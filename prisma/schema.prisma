generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  hash      String   @id // sha256 hex of the full "rq_..." key
  tenant    String
  createdAt DateTime @default(now())
}

model JobRecord {
  id             String   @id
  tenant         String
  type           String
  status         String   @default("pending") // pending (in outbox)|queued|active|completed|failed|dead
  payload        Json
  priority       Int      @default(5) // 1 high … 10 low
  idempotencyKey String?
  attempts       Int      @default(0)
  result         Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenant, idempotencyKey])
  @@index([tenant, status])
}

/// Written in the same transaction as its JobRecord; the relay publishes it to BullMQ.
model Outbox {
  id          BigInt    @id @default(autoincrement())
  jobId       String    @unique
  delayMs     Int?
  traceparent String? // W3C trace context of the enqueue span; the worker's span continues it
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, id])
}

/// One row per completed side-effect step; a re-delivered job skips steps already here.
model EffectLog {
  jobId     String
  step      String
  result    Json?
  createdAt DateTime @default(now())

  @@id([jobId, step])
}

/// Monthly LLM spend cap per tenant. No row = LLM_DEFAULT_MONTHLY_USD (default 0: LLM jobs are refused until a budget is set).
model TenantBudget {
  tenant          String  @id
  monthlyUsdLimit Decimal @db.Decimal(12, 6)
}

/// One row per completed LLM call (the one that produced the result), priced from src/llm/prices.ts.
model LlmUsage {
  id               BigInt   @id @default(autoincrement())
  jobId            String
  tenant           String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  costUsd          Decimal  @db.Decimal(12, 6)
  latencyMs        Int
  createdAt        DateTime @default(now())

  @@index([tenant, createdAt])
}
